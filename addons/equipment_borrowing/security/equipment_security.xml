<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_equipment_borrowing" model="res.groups.privilege">
        <field name="name">Equipment Borrowing</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Equipment Manager</field>
        <field name="privilege_id" ref="privilege_equipment_borrowing"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Create, edit and archive shared equipment.</field>
    </record>

    <record id="rule_borrow_request_own" model="ir.rule">
        <field name="name">Borrow requests: own records</field>
        <field name="model_id" ref="model_equipment_borrowing_request"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('applicant_id', '=', user.id)]</field>
    </record>

    <record id="rule_borrow_request_manager" model="ir.rule">
        <field name="name">Borrow requests: manager access</field>
        <field name="model_id" ref="model_equipment_borrowing_request"/>
        <field name="groups" eval="[Command.link(ref('group_equipment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
