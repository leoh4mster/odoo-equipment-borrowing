<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_list" model="ir.ui.view">
        <field name="name">equipment.borrowing.equipment.list</field>
        <field name="model">equipment.borrowing.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">equipment.borrowing.equipment.form</field>
        <field name="model">equipment.borrowing.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Borrow Requests">
                            <field name="request_ids" readonly="True">
                                <list create="False" edit="False" delete="False"
                                      decoration-bf="state == 'pending'"
                                      decoration-warning="state == 'pending'"
                                      decoration-muted="state in ('rejected', 'returned')">
                                    <field name="name"/>
                                    <field name="applicant_id"/>
                                    <field name="borrow_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending'"
                                           decoration-success="state == 'approved'"
                                           decoration-info="state == 'borrowed'"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_search" model="ir.ui.view">
        <field name="name">equipment.borrowing.equipment.search</field>
        <field name="model">equipment.borrowing.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>
                <group>
                    <filter name="group_by_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">equipment.borrowing.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_search"/>
        <field name="help" type="html">
            <p>Equipment administrators maintain this list of individually numbered items.</p>
        </field>
    </record>
</odoo>
